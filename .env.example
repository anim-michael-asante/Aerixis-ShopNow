# Aerixis ShopNow Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# Security & Core
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SSL & Production Security Headers
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS=False
